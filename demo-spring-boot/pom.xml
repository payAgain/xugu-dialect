<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.xugu</groupId>
    <artifactId>xugu-dialect-parent</artifactId>
    <version>7.4.5.Final</version>
  </parent>

  <artifactId>demo-spring-boot</artifactId>
  <packaging>jar</packaging>

  <name>demo-spring-boot</name>
  <description>Spring Boot 4.1.0 demo consuming xugu-dialect against real XuguDB</description>

  <properties>
    <!--
      Boot 4.1.0 BOM defaults hibernate.version to 7.4.1.Final.
      Force 7.4.5.Final (Charter / ADR-0001). Prove with dependency:tree.
    -->
    <hibernate.version>7.4.5.Final</hibernate.version>
    <spring-boot.version>4.1.0</spring-boot.version>
    <!-- Default off; enable with -Dxugu.run.integration=true or env XUGU_RUN_IT=true -->
    <xugu.run.integration>false</xugu.run.integration>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- Direct DM entry after Boot BOM import wins over BOM-managed 7.4.1 -->
      <dependency>
        <groupId>org.hibernate.orm</groupId>
        <artifactId>hibernate-core</artifactId>
        <version>${hibernate.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>com.xugu</groupId>
      <artifactId>xugu-dialect</artifactId>
    </dependency>
    <dependency>
      <groupId>com.xugu</groupId>
      <artifactId>xugu-jdbc</artifactId>
      <version>12.3.6</version>
      <scope>system</scope>
      <systemPath>${maven.multiModuleProjectDirectory}/xugu-jdbc-12.3.6.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <!--
      Hibernate JSON FormatMapper (SqlTypes.JSON / json_value / json_arrayagg) auto-detects
      Jackson 2 or Jackson 3 on the classpath. Boot 4 starter brings Jackson 3 (tools.jackson).
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jackson</artifactId>
    </dependency>
    <!-- I-007 P-005 Track B: Flyway migration path (disabled by default; Flyway IT enables). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-flyway</artifactId>
    </dependency>
    <!-- Flyway 12 splits DB support; Xugu JDBC reports "XuguDB" — use Oracle module + database-type override. -->
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-database-oracle</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <configuration>
          <!-- system-scope JDBC jar must be on the runnable classpath -->
          <includeSystemScope>true</includeSystemScope>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/*Test.java</include>
            <include>**/*Tests.java</include>
            <include>**/*IT.java</include>
          </includes>
          <systemPropertyVariables>
            <xugu.run.integration>${xugu.run.integration}</xugu.run.integration>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
