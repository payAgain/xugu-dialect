<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.xugu</groupId>
    <artifactId>xugu-dialect-parent</artifactId>
    <version>7.4.5.Final</version>
  </parent>

  <artifactId>xugu-dialect</artifactId>
  <packaging>jar</packaging>

  <name>xugu-dialect</name>
  <description>XuguDB Hibernate dialect library (scaffold)</description>

  <properties>
    <!-- Default off; enable with -Dxugu.run.integration=true or env XUGU_RUN_IT=true -->
    <xugu.run.integration>false</xugu.run.integration>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.hibernate.orm</groupId>
      <artifactId>hibernate-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.xugu</groupId>
      <artifactId>xugu-jdbc</artifactId>
      <version>12.3.6</version>
      <scope>system</scope>
      <systemPath>${maven.multiModuleProjectDirectory}/xugu-jdbc-12.3.6.jar</systemPath>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Hibernate JSON FormatMapper for @JdbcTypeCode(JSON) ORM tests -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>2.17.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- Include *IT for gated live-DB tests (still skipped unless gate is on). -->
          <includes>
            <include>**/*Test.java</include>
            <include>**/*Tests.java</include>
            <include>**/*IT.java</include>
          </includes>
          <systemPropertyVariables>
            <xugu.run.integration>${xugu.run.integration}</xugu.run.integration>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
